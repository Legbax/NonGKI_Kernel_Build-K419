#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
		if (arg2 == CMD_SUSFS_ADD_CLOCK_OFFSET) {
			int error = 0;
			if (!ksu_access_ok((void __user*)arg3, sizeof(struct st_susfs_clock_offset))) {
				pr_err("susfs: CMD_SUSFS_ADD_CLOCK_OFFSET -> arg3 is not accessible\n");
				return 0;
			}
			if (!ksu_access_ok((void __user*)arg5, sizeof(error))) {
				pr_err("susfs: CMD_SUSFS_ADD_CLOCK_OFFSET -> arg5 is not accessible\n");
				return 0;
			}
			error = susfs_add_clock_offset((struct st_susfs_clock_offset __user*)arg3);
			pr_info("susfs: CMD_SUSFS_ADD_CLOCK_OFFSET -> ret: %d\n", error);
			if (copy_to_user((void __user*)arg5, &error, sizeof(error)))
				pr_info("susfs: copy_to_user() failed\n");
			return 0;
		}
#endif //#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
